# ==============================================================================
# Bhagyoday Ayurveda - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or use these variables in your wp-config.php / server environment.
# NEVER commit the real .env file or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# WordPress Database Settings
# ------------------------------------------------------------------------------
DB_NAME=bhagyoday_db
DB_USER=wp_user
DB_PASSWORD=your_database_password_here
DB_HOST=localhost
DB_CHARSET=utf8mb4
DB_COLLATE=

# ------------------------------------------------------------------------------
# WordPress URLs & Environment
# ------------------------------------------------------------------------------
WP_ENV=development
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# ------------------------------------------------------------------------------
# WordPress Authentication Unique Keys and Salts
# Generate fresh keys at: https://api.wordpress.org/secret-key/1.1/salt/
# ------------------------------------------------------------------------------
AUTH_KEY=put_your_unique_phrase_here
SECURE_AUTH_KEY=put_your_unique_phrase_here
LOGGED_IN_KEY=put_your_unique_phrase_here
NONCE_KEY=put_your_unique_phrase_here
AUTH_SALT=put_your_unique_phrase_here
SECURE_AUTH_SALT=put_your_unique_phrase_here
LOGGED_IN_SALT=put_your_unique_phrase_here
NONCE_SALT=put_your_unique_phrase_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Online Checkout & ₹100 COD Confirmation Fee)
# Configurable in: WP Admin > WooCommerce > Settings > Payments > Razorpay
#              and WP Admin > Settings > Ayur Commerce > COD Confirmation
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# ------------------------------------------------------------------------------
# Google Places API (Checkout Address Autocomplete)
# Configurable in: WP Admin > Settings > Ayur Commerce > Address Autofill
# Note: Restrict this key in Google Cloud Console to Places API and your domain.
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=AIzaSy_placeholder_restricted_places_key

# ------------------------------------------------------------------------------
# Shiprocket Fulfillment Integration
# Configurable in: WP Admin > Settings > Ayur Commerce > Shiprocket
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=merchant@bhagyodayayurveda.in
SHIPROCKET_PASSWORD=placeholder_shiprocket_password

# ------------------------------------------------------------------------------
# Meta Conversions API (CAPI) & Pixel Tracking
# Configurable in: WP Admin > Settings > Ayur Commerce > Meta Tracking
# ------------------------------------------------------------------------------
META_PIXEL_ID=placeholder_pixel_id
META_CAPI_TOKEN=EAAB_placeholder_capi_access_token
META_TEST_EVENT_CODE=

# ------------------------------------------------------------------------------
# Store Customer Care & WhatsApp Helpline
# ------------------------------------------------------------------------------
WHATSAPP_SUPPORT_NUMBER=+918888686858
STORE_CONTACT_EMAIL=vijaykulal8833@gmail.com

# ------------------------------------------------------------------------------
# Bhagyoday Ayurveda AI Product Expert Chatbot
# Configurable in: WP Admin > WooCommerce > AI Product Chatbot
# ------------------------------------------------------------------------------
AYUR_CHATBOT_ENABLED=yes
AYUR_CHATBOT_PROVIDER=gemini
AYUR_CHATBOT_API_KEY=placeholder_gemini_or_openai_api_key
AYUR_CHATBOT_MODEL=gemini-1.5-flash
AYUR_CHATBOT_POSITION=bottom-left
